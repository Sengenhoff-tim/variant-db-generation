{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "TODO",
    "title": "nf-core-like/variant-db-generation pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "aa_changes": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.vcf(\\.gz)?$",
                "errorMessage": "TODO '.vcf.gz'"
            },
            "ranges": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.csv$",
                "errorMessage": "TODO '.txt.gz'"
            },
            "mzml": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.mzml$",
                "errorMessage": "TODO '.mzml'"
            }
        },
        "required": ["sample", "aa_changes", "ranges", "mzml"]
    }
}
