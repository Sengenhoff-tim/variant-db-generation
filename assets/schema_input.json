{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "TODO",
    "title": "nf-core-like/variant-db-generation pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "aa_changes": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.vcf(\\.gz)?$",
                "errorMessage": "aa_changes must be a valid path to a '.vcf' or '.vcf.gz' file"
            },
            "ranges": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.csv$",
                "errorMessage": "ranges must be a valid path to a '.csv' file"
            },
            "mzml": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.mz[Mm][Ll](\\.gz)?$",
                "errorMessage": "mzml must be a valid path to a '.mzML' file"
            }
        },
        "required": ["sample", "aa_changes"],
        "anyOf": [
            { "required": ["ranges"] },
            { "required": ["mzml"] }
        ],
        "errorMessage": {
            "anyOf": "At least one of 'ranges' or 'mzml' must be provided"
        }
    }
}